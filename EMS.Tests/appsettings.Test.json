{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=EMS_Test;Integrated Security=true;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "test-secret-key-that-is-long-enough-for-testing-purposes-only",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "Issuer": "test-issuer",
    "Audience": "test-audience"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "EMS": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/test-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
