<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Minimum required for test execution -->
  <RunConfiguration>
    <!-- Maximum timeout for test execution (30 seconds) -->
    <TestTimeouts>
      <Individual>30000</Individual>
    </TestTimeouts>
    
    <!-- Number of parallel test threads -->
    <MaxCpuCount>4</MaxCpuCount>
    
    <!-- Stop test run on first failure (optional) -->
    <StopOnFailure>false</StopOnFailure>
  </RunConfiguration>

  <!-- Code Coverage Configuration -->
  <CodeCoverage>
    <!-- Assemblies to include in coverage -->
    <ModulePaths>
      <ModulePath>.*EMS\.Application\.dll$</ModulePath>
      <ModulePath>.*EMS\.Infrastructure\.dll$</ModulePath>
      <ModulePath>.*EMS\.Api\.dll$</ModulePath>
    </ModulePaths>

    <!-- Assemblies to exclude from coverage -->
    <ExcludeAttributeFilters>
      <ExcludeAttributeFilter>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeAttributeFilter>
    </ExcludeAttributeFilters>

    <!-- Exclude methods without source -->
    <UseVerifiableInstrumentation>true</UseVerifiableInstrumentation>

    <!-- Enable code coverage -->
    <AllowLowIntegrityProcesses>true</AllowLowIntegrityProcesses>

    <!-- Source link support -->
    <CollectAltCoverageMetrics>false</CollectAltCoverageMetrics>
  </CodeCoverage>

  <!-- Logger Configuration -->
  <LoggerRunSettings>
    <Verbosity>Verbose</Verbosity>
  </LoggerRunSettings>

  <!-- MSTest specific settings -->
  <MSTest>
    <!-- Parallel execution -->
    <Parallelize Workers="0" Scope="MethodLevel" />
    
    <!-- Timeout per test (milliseconds) -->
    <Timeout>30000</Timeout>
  </MSTest>

  <!-- xUnit specific settings -->
  <xUnit>
    <!-- Diagnostic messages -->
    <DiagnosticMessages>true</DiagnosticMessages>
    
    <!-- Parallel execution -->
    <ParallelizeAssembly>true</ParallelizeAssembly>
    <ParallelizeTestCollections>true</ParallelizeTestCollections>
  </xUnit>

  <!-- Test adapter configuration -->
  <TestAdapterPaths>
    <TestAdapterPath>.</TestAdapterPath>
  </TestAdapterPaths>

  <!-- Environment variables for tests -->
  <EnvironmentVariables>
    <Variable name="ASPNETCORE_ENVIRONMENT" value="Test" />
    <Variable name="ConnectionStrings__DefaultConnection" value="Server=(localdb)\mssqllocaldb;Database=EMS_Test;Integrated Security=true;" />
    <Variable name="ConnectionStrings__Redis" value="localhost:6379" />
    <Variable name="JwtSettings__SecretKey" value="test-secret-key-for-testing-purposes-only" />
  </EnvironmentVariables>
</RunSettings>
