```json
{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EMS_DB;...",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*"
