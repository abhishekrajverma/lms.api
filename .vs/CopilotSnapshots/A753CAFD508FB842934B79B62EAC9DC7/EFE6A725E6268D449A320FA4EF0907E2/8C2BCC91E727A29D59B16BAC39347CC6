namespace EMS.Domain.Entities;

using EMS.Domain.Enums;

/// <summary>
/// User entity for authentication and authorization
/// Every person accessing EMS (Admin, Faculty, Student, Parent) must have a User account
/// 
/// Key Features:
/// - Authentication (username, email, password hash)
/// - Authorization (roles and permissions)
/// - Account management (status, locked, etc.)
/// - Audit trail (CreatedAt, UpdatedAt from BaseEntity)
/// 
/// Security Notes:
/// - Password is stored as hash (bcrypt, not plain text)
/// - Email must be unique
/// - Username must be unique
/// - Failed login attempts trigger lockout
/// </summary>
public class User : BaseEntity
{
    /// <summary>
    /// Unique username for login
    /// Example: "john.doe", "faculty_001"
    /// Must be 3-50 characters
    /// </summary>
    public string Username { get; set; } = string.Empty;

    /// <summary>
    /// User's email address
    /// Must be unique across system
    /// Used for: password reset, notifications, login
    /// </summary>
    public string Email { get; set; } = string.Empty;

    /// <summary>
    /// First name of the user
    /// </summary>
    public string FirstName { get; set; } = string.Empty;

    /// <summary>
    /// Last name of the user
    /// </summary>
    public string LastName { get; set; } = string.Empty;

    /// <summary>
    /// Hashed password using bcrypt
    /// Never store plain text passwords!
    /// </summary>
    public string PasswordHash { get; set; } = string.Empty;

    /// <summary>
    /// User's phone number (optional)
    /// </summary>
    public string? PhoneNumber { get; set; }

    /// <summary>
    /// User's profile photo URL
    /// Can be stored in cloud storage, CDN, or local file system
    /// </summary>
    public string? ProfilePhotoUrl { get; set; }

    /// <summary>
    /// User's role (Admin, Faculty, Student, Parent, etc.)
    /// Determines what features are accessible
    /// </summary>
    public UserRole Role { get; set; } = UserRole.Student;

    /// <summary>
    /// Current account status (Active, Locked, Disabled, etc.)
    /// </summary>
    public AccountStatus AccountStatus { get; set; } = AccountStatus.Active;

    /// <summary>
    /// Is email verified?
    /// Students must verify email before accessing system
    /// </summary>
    public bool IsEmailVerified { get; set; } = false;

    /// <summary>
    /// Timestamp when email verification link was sent
    /// Used to expire verification links after 24 hours
    /// </summary>
    public DateTime? EmailVerificationSentAt { get; set; }

    /// <summary>
    /// Last successful login timestamp
    /// Useful for: detecting inactive accounts, security audits
    /// </summary>
    public DateTime? LastLoginAt { get; set; }

    /// <summary>
    /// Last IP address that logged in
    /// Used for: security monitoring, detecting unauthorized access
    /// </summary>
    public string? LastLoginIpAddress { get; set; }

    /// <summary>
    /// Number of failed login attempts
    /// After 5 failed attempts, account is locked for 30 minutes
    /// </summary>
    public int FailedLoginAttempts { get; set; } = 0;

    /// <summary>
    /// When account was locked due to failed login attempts
    /// Account auto-unlocks after 30 minutes
    /// </summary>
    public DateTime? LockedUntil { get; set; }

    /// <summary>
    /// When password was last changed
    /// Used to enforce password expiration policies
    /// </summary>
    public DateTime? PasswordChangedAt { get; set; }

    /// <summary>
    /// Is multi-factor authentication (MFA) enabled?
    /// Can use SMS OTP or authenticator app
    /// </summary>
    public bool IsMfaEnabled { get; set; } = false;

    /// <summary>
    /// Two-factor authentication secret (encrypted)
    /// Used with authenticator apps like Google Authenticator
    /// </summary>
    public string? MfaSecret { get; set; }

    /// <summary>
    /// Backup codes for MFA (comma-separated, hashed)
    /// If user loses authenticator, can use backup codes
    /// </summary>
    public string? MfaBackupCodes { get; set; }

    /// <summary>
    /// Optional: Department ID if user is faculty or staff
    /// </summary>
    public int? DepartmentId { get; set; }

    /// <summary>
    /// Optional: Related Department entity (navigation)
    /// </summary>
    public Department? Department { get; set; }

    /// <summary>
    /// Optional: Employee/Staff ID number
    /// Format: EMP001, EMP002, etc.
    /// </summary>
    public string? EmployeeId { get; set; }

    /// <summary>
    /// Constructor
    /// </summary>
    public User()
    {
        CreatedAt = DateTime.UtcNow;
    }

    /// <summary>
    /// Full name of user (FirstName + LastName)
    /// </summary>
    public string GetFullName() => $"{FirstName} {LastName}".Trim();

    /// <summary>
    /// Record a successful login
    /// Called after successful authentication
    /// </summary>
    public void RecordSuccessfulLogin(string? ipAddress = null)
    {
        LastLoginAt = DateTime.UtcNow;
        LastLoginIpAddress = ipAddress;
        FailedLoginAttempts = 0;
        LockedUntil = null;
    }

    /// <summary>
    /// Record a failed login attempt
    /// After 5 failed attempts, lock account for 30 minutes
    /// </summary>
    public void RecordFailedLoginAttempt()
    {
        FailedLoginAttempts++;

        if (FailedLoginAttempts >= 5)
        {
            LockedUntil = DateTime.UtcNow.AddMinutes(30);
            AccountStatus = AccountStatus.Locked;
        }
    }

    /// <summary>
    /// Unlock account (after timeout or admin action)
    /// </summary>
    public void UnlockAccount()
    {
        FailedLoginAttempts = 0;
        LockedUntil = null;
        AccountStatus = AccountStatus.Active;
    }

    /// <summary>
    /// Check if account is currently locked
    /// </summary>
    public bool IsAccountLocked()
    {
        if (LockedUntil == null)
            return false;

        if (DateTime.UtcNow > LockedUntil)
        {
            UnlockAccount();
            return false;
        }

        return true;
    }

    /// <summary>
    /// Enable two-factor authentication
    /// </summary>
    public void EnableMfa(string secret)
    {
        IsMfaEnabled = true;
        MfaSecret = secret;
    }

    /// <summary>
    /// Disable two-factor authentication
    /// </summary>
    public void DisableMfa()
    {
        IsMfaEnabled = false;
        MfaSecret = null;
        MfaBackupCodes = null;
    }

    /// <summary>
    /// Is password older than X days? (for expiration policy)
    /// </summary>
    public bool IsPasswordExpired(int expirationDays = 90)
    {
        if (PasswordChangedAt == null)
            return true;

        return (DateTime.UtcNow - PasswordChangedAt).TotalDays > expirationDays;
    }
}
