namespace EMS.Application.Interfaces.Services;

using EMS.Application.DTOs.Student;
using EMS.Application.DTOs.Course;
using EMS.Application.DTOs.Grade;
using EMS.Application.DTOs.Attendance;
using EMS.Shared.Common;

/// <summary>
/// Interface for Student service
/// Defines all operations related to student management
/// </summary>
public interface IStudentService
{
    /// <summary>
    /// Get student by ID
    /// </summary>
    Task<StudentResponse?> GetStudentByIdAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get all students with pagination
    /// </summary>
    Task<PaginatedResponse<StudentResponse>> GetAllStudentsAsync(
        int pageNumber = 1,
        int pageSize = 10,
        CancellationToken cancellationToken = default);

    /// <summary>
    /// Create new student
    /// </summary>
    Task<int> CreateStudentAsync(CreateStudentRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Update student
    /// </summary>
    Task<int> UpdateStudentAsync(int id, UpdateStudentRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Delete student (soft delete)
    /// </summary>
    Task<bool> DeleteStudentAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Search students by name or enrollment number
    /// </summary>
    Task<List<StudentResponse>> SearchStudentsAsync(string searchTerm, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get students by department
    /// </summary>
    Task<List<StudentResponse>> GetStudentsByDepartmentAsync(int departmentId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get students by status
    /// </summary>
    Task<List<StudentResponse>> GetStudentsByStatusAsync(string status, CancellationToken cancellationToken = default);

    /// <summary>
    /// Update student GPA
    /// </summary>
    Task<bool> UpdateStudentGPAAsync(int id, decimal newGPA, CancellationToken cancellationToken = default);

    /// <summary>
    /// Check if student is eligible to graduate
    /// </summary>
    Task<bool> IsEligibleToGraduateAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Mark student as graduated
    /// </summary>
    Task<bool> MarkAsGraduatedAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get students on academic probation
    /// </summary>
    Task<List<StudentResponse>> GetStudentsOnProbationAsync(CancellationToken cancellationToken = default);
}

/// <summary>
/// Interface for Course service
/// Defines all operations related to course management
/// </summary>
public interface ICourseService
{
    /// <summary>
    /// Get course by ID
    /// </summary>
    Task<CourseResponse?> GetCourseByIdAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get all courses with pagination
    /// </summary>
    Task<PaginatedResponse<CourseResponse>> GetAllCoursesAsync(
        int pageNumber = 1,
        int pageSize = 10,
        CancellationToken cancellationToken = default);

    /// <summary>
    /// Create new course
    /// </summary>
    Task<int> CreateCourseAsync(CreateCourseRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Update course
    /// </summary>
    Task<int> UpdateCourseAsync(int id, UpdateCourseRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Delete course (soft delete)
    /// </summary>
    Task<bool> DeleteCourseAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Search courses by code or name
    /// </summary>
    Task<List<CourseResponse>> SearchCoursesAsync(string searchTerm, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get courses by department
    /// </summary>
    Task<List<CourseResponse>> GetCoursesByDepartmentAsync(int departmentId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get courses by status
    /// </summary>
    Task<List<CourseResponse>> GetCoursesByStatusAsync(string status, CancellationToken cancellationToken = default);

    /// <summary>
    /// Enroll student in course
    /// </summary>
    Task<bool> EnrollStudentAsync(int courseId, int studentId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Withdraw student from course
    /// </summary>
    Task<bool> WithdrawStudentAsync(int courseId, int studentId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get enrolled students for a course
    /// </summary>
    Task<List<StudentResponse>> GetEnrolledStudentsAsync(int courseId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Check if student is enrolled in course
    /// </summary>
    Task<bool> IsStudentEnrolledAsync(int courseId, int studentId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get available seats for course
    /// </summary>
    Task<int> GetAvailableSeatsAsync(int courseId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Check if course can accept new enrollments
    /// </summary>
    Task<bool> CanEnrollAsync(int courseId, CancellationToken cancellationToken = default);
}

/// <summary>
/// Interface for Grade service
/// Defines all operations related to grade management
/// </summary>
public interface IGradeService
{
    /// <summary>
    /// Get grade by ID
    /// </summary>
    Task<GradeResponse?> GetGradeByIdAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get all grades with pagination
    /// </summary>
    Task<PaginatedResponse<GradeResponse>> GetAllGradesAsync(
        int pageNumber = 1,
        int pageSize = 10,
        CancellationToken cancellationToken = default);

    /// <summary>
    /// Create new grade record
    /// </summary>
    Task<int> CreateGradeAsync(CreateGradeRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Update grade record
    /// </summary>
    Task<int> UpdateGradeAsync(int id, UpdateGradeRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Delete grade record
    /// </summary>
    Task<bool> DeleteGradeAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get grades for student
    /// </summary>
    Task<List<GradeResponse>> GetStudentGradesAsync(int studentId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get grades for course
    /// </summary>
    Task<List<GradeResponse>> GetCourseGradesAsync(int courseId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Submit grade (lock from edits)
    /// </summary>
    Task<bool> SubmitGradeAsync(int id, int instructorId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Approve grade (admin only)
    /// </summary>
    Task<bool> ApproveGradeAsync(int id, int approverId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Reject grade (send back for revision)
    /// </summary>
    Task<bool> RejectGradeAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// File dispute against grade
    /// </summary>
    Task<bool> FileDisputeAsync(int id, string reason, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get student's semester GPA
    /// </summary>
    Task<decimal> GetSemesterGPAAsync(int studentId, string semester, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get student's cumulative GPA
    /// </summary>
    Task<decimal> GetCumulativeGPAAsync(int studentId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Calculate final grade percentages for all students in course
    /// </summary>
    Task<bool> CalculateFinalGradesAsync(int courseId, CancellationToken cancellationToken = default);
}

/// <summary>
/// Interface for Attendance service
/// Defines all operations related to attendance management
/// </summary>
public interface IAttendanceService
{
    /// <summary>
    /// Get attendance record by ID
    /// </summary>
    Task<AttendanceResponse?> GetAttendanceByIdAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get all attendance records with pagination
    /// </summary>
    Task<PaginatedResponse<AttendanceResponse>> GetAllAttendanceAsync(
        int pageNumber = 1,
        int pageSize = 10,
        CancellationToken cancellationToken = default);

    /// <summary>
    /// Mark student attendance
    /// </summary>
    Task<int> MarkAttendanceAsync(CreateAttendanceRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Update attendance record
    /// </summary>
    Task<int> UpdateAttendanceAsync(int id, UpdateAttendanceRequest request, CancellationToken cancellationToken = default);

    /// <summary>
    /// Delete attendance record
    /// </summary>
    Task<bool> DeleteAttendanceAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get attendance records for student in course
    /// </summary>
    Task<List<AttendanceResponse>> GetStudentCourseAttendanceAsync(int studentId, int courseId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get attendance records for all students in course
    /// </summary>
    Task<List<AttendanceResponse>> GetCourseAttendanceAsync(int courseId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get attendance summary for student in course
    /// </summary>
    Task<AttendanceSummaryResponse?> GetAttendanceSummaryAsync(int studentId, int courseId, CancellationToken cancellationToken = default);

    /// <summary>
    /// Approve/excuse absence
    /// </summary>
    Task<bool> ApproveAbsenceAsync(int id, string reason, CancellationToken cancellationToken = default);

    /// <summary>
    /// Reject approval of absence
    /// </summary>
    Task<bool> RejectApprovalAsync(int id, CancellationToken cancellationToken = default);

    /// <summary>
    /// Get students with attendance below threshold
    /// </summary>
    Task<List<StudentResponse>> GetLowAttendanceStudentsAsync(int courseId, decimal threshold = 75, CancellationToken cancellationToken = default);

    /// <summary>
    /// Bulk mark attendance for class
    /// </summary>
    Task<bool> BulkMarkAttendanceAsync(List<CreateAttendanceRequest> requests, CancellationToken cancellationToken = default);

    /// <summary>
    /// Lock attendance after deadline
    /// </summary>
    Task<bool> LockAttendanceAsync(int id, CancellationToken cancellationToken = default);
}
