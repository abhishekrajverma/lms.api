# EMS Environment Configuration

# ============================================================================
# Database Configuration
# ============================================================================
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=EMS_DB;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;

# ============================================================================
# Redis Configuration
# ============================================================================
ConnectionStrings__Redis=localhost:6379

# ============================================================================
# JWT Settings
# ============================================================================
JwtSettings__SecretKey=your-super-secret-jwt-key-change-this-in-production-at-least-32-characters
JwtSettings__ExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=7
JwtSettings__Issuer=ems-api
JwtSettings__Audience=ems-clients

# ============================================================================
# Application Settings
# ============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ============================================================================
# Logging Configuration
# ============================================================================
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__EMS=Debug

# ============================================================================
# Serilog Configuration
# ============================================================================
Serilog__MinimumLevel=Information
Serilog__WriteTo__0__Name=File
Serilog__WriteTo__0__Args__path=logs/ems-api-.txt
Serilog__WriteTo__0__Args__rollingInterval=Day

# ============================================================================
# Email Service (Optional)
# ============================================================================
EmailService__Host=smtp.gmail.com
EmailService__Port=587
EmailService__Username=your-email@gmail.com
EmailService__Password=your-app-password
EmailService__FromAddress=noreply@ems.com
EmailService__FromName=EMS Admin

# ============================================================================
# External Services (Optional)
# ============================================================================
# SendGrid API Key
SendGrid__ApiKey=your-sendgrid-api-key

# ============================================================================
# CORS Configuration
# ============================================================================
CORS__AllowedOrigins=http://localhost:3000,http://localhost:4200,https://ems.example.com

# ============================================================================
# Security
# ============================================================================
# HTTPS
UseHttps=true
CertificatePath=/app/certs/ems-cert.pfx
CertificatePassword=your-certificate-password

# ============================================================================
# API Documentation
# ============================================================================
Swagger__Title=EMS API
Swagger__Version=1.0.0
Swagger__Description=Educational Management System API
Swagger__ContactName=EMS Support
Swagger__ContactEmail=support@ems.com
